<?php

namespace App\Service\AI;

class Orchestrator
{
    public function handle(string $question): array
    {
        $questionLower = mb_strtolower($question);

        $modules = [];

        if ($this->contains($questionLower, ['droit', 'loi', 'juridique'])) {
            $modules[] = 'LegalAI';
        }

        if ($this->contains($questionLower, ['compte', 'facture', 'finance', 'argent'])) {
            $modules[] = 'ComptaAI';
        }

        if ($this->contains($questionLower, ['secrétaire', 'mail', 'organisation'])) {
            $modules[] = 'OfficeAI';
        }

        if ($this->contains($questionLower, ['recherche', 'science', 'analyse'])) {
            $modules[] = 'ResearchAI';
        }

        if (empty($modules)) {
            $modules[] = 'CoreAI';
        }

        return [
            'question' => $question,
            'modules_used' => $modules,
            'response' => $this->generateFakeResponse($question, $modules),
        ];
    }

    private function contains(string $text, array $keywords): bool
    {
        foreach ($keywords as $keyword) {
            if (str_contains($text, $keyword)) {
                return true;
            }
        }
        return false;
    }

    private function generateFakeResponse(string $question, array $modules): string
    {
        return "Analyse de la question via : " . implode(', ', $modules);
    }
}
